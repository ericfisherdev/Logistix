<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>Logistix</AssemblyName>
        <RootNamespace>Logistix</RootNamespace>
        <Description>Revival of PersonalLogistics for DSP 0.10.34. Manage inventory by requesting items from or auto-recycling items to logistics stations. Also recycles littered items to logistics network.</Description>
        <RepositoryUrl>https://github.com/ericfisherdev/Logistix</RepositoryUrl>
        <PackageProjectUrl>https://github.com/ericfisherdev/Logistix</PackageProjectUrl>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>9.0</LangVersion>
        <Authors>Eric Fisher</Authors>

        <!-- Shared pins: each PackageReference below and the matching Thunderstore
             manifest dependency (Logistix.Thunderstore.targets) both read from here so
             the two can never drift apart. -->
        <LDBToolVersion>3.0.0</LDBToolVersion>
        <CommonAPIVersion>1.6.5</CommonAPIVersion>
        <DSPModSaveVersion>1.2.0</DSPModSaveVersion>
        <NebulaModApiVersion>2.1.0</NebulaModApiVersion>

        <!-- BepInEx.Core resolves 5.4.21 on NuGet, but the xiaoye97-BepInEx package on
             Thunderstore only publishes up to 5.4.17 (confirmed against the live
             Thunderstore API 2026-09-11), so this one dependency cannot be derived from
             the NuGet pin and is held here as an explicit Thunderstore-only value. -->
        <ThunderstoreBepInExVersion>5.4.17</ThunderstoreBepInExVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <PlatformTarget>x64</PlatformTarget>
        <WarningLevel>0</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <Compile Remove="TestApp\InventoryManagerTest.cs" />
        <Compile Remove="PLU\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Remove="PLU\**" />
        <EmbeddedResource Include="WhiteLogo_2.png" LogicalName="Logistix.WhiteLogo.png" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Examples" />
        <Folder Include="Libs" />
        <Folder Include="StationStorage" />
        <Folder Include="Utilities" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="META-INF\MANIFEST.MF" />
        <None Remove="PLU\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="DysonSphereProgram.GameLibs" Version="0.10.34.28529-r.0" />
        <PackageReference Include="DysonSphereProgram.Modding.CommonAPI" Version="$(CommonAPIVersion)" />
        <PackageReference Include="DysonSphereProgram.Modding.DSPModSave" Version="$(DSPModSaveVersion)" />
        <PackageReference Include="DysonSphereProgram.Modding.LDBTool" Version="$(LDBToolVersion)" />
        <PackageReference Include="DysonSphereProgram.Modding.NebulaMultiplayerModApi" Version="$(NebulaModApiVersion)" IncludeAssets="compile" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.62">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.3.0-beta.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <Import Project="Logistix.Thunderstore.targets" />

</Project>
